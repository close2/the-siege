[Unit]
Description=The Siege v2 — habit challenge server
After=network.target

[Service]
Type=simple
User=siege
Group=siege
WorkingDirectory=/var/lib/siege
Environment=BIND=127.0.0.1:8080
Environment=DB_PATH=/var/lib/siege/siege.db
Environment=STATIC_DIR=/opt/siege/client
Environment=VAPID_PRIVATE_KEY_PATH=/var/lib/siege/vapid_private.pem
Environment=VAPID_SUBJECT=mailto:admin@example.com
Environment=RUST_LOG=info,tower_http=warn
ExecStart=/opt/siege/siege-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/siege

[Install]
WantedBy=multi-user.target
